# SMTP connection details. Port 465 normally uses SMTP_SECURE=true;
# port 587 normally uses SMTP_SECURE=false.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# The authenticated SMTP account usually needs to match MAIL_FROM.
MAIL_FROM=your-email@gmail.com
MAIL_TO=email@gmail.com
